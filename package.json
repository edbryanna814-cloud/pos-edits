{
  "name": "pharmacy-pos-management",
  "version": "0.2.3",
  "description": "Pharmacy POS and management desktop application for one company.",
  "main": "./out/main/index.js",
  "private": true,
  "type": "commonjs",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "db:start": "powershell -ExecutionPolicy Bypass -File scripts/mongodb.ps1 start",
    "db:stop": "powershell -ExecutionPolicy Bypass -File scripts/mongodb.ps1 stop",
    "db:status": "powershell -ExecutionPolicy Bypass -File scripts/mongodb.ps1 status",
    "db:init": "powershell -ExecutionPolicy Bypass -File scripts/mongodb.ps1 init",
    "pretest": "npm run build",
    "test": "playwright test",
    "test:unit": "vitest run --dir tests/unit",
    "scan:signing": "node scripts/scan-signing.mjs",
    "sbom": "node scripts/sbom.mjs",
    "dist": "powershell -ExecutionPolicy Bypass -File scripts/prepare-mongodb.ps1 && npm run build && electron-builder --win nsis --x64"
  },
  "build": {
    "appId": "com.pharmacy.pos",
    "productName": "Pharmacy POS",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "vendor/mongodb",
        "to": "mongodb"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Pharmacy-POS-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    }
  },
  "dependencies": {
    "hash-wasm": "4.12.0",
    "mongodb": "7.8.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^5.1.0"
  }
}
