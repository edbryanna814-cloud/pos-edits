{
  "name": "pharmacy-pos-management",
  "version": "0.1.0",
  "description": "Pharmacy POS and management desktop application for one company.",
  "main": "./out/main/index.js",
  "private": true,
  "type": "commonjs",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "db:start": "powershell -ExecutionPolicy Bypass -File scripts/mongodb.ps1 start",
    "db:stop": "powershell -ExecutionPolicy Bypass -File scripts/mongodb.ps1 stop",
    "db:status": "powershell -ExecutionPolicy Bypass -File scripts/mongodb.ps1 status",
    "db:init": "powershell -ExecutionPolicy Bypass -File scripts/mongodb.ps1 init",
    "pretest": "npm run build",
    "test": "playwright test"
  },
  "dependencies": {
    "mongodb": "^7.8.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^45.2.1",
    "electron-vite": "^6.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.7"
  }
}
